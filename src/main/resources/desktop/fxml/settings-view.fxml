<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<VBox xmlns="http://javafx.com/javafx/21"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="kg.edu.nagisa.rootsight.desktop.controller.SettingsViewController"
      stylesheets="@../css/rootsight.css"
      prefWidth="560.0" prefHeight="510.0" spacing="18.0" styleClass="settings-root">
    <HBox alignment="CENTER_LEFT">
        <VBox spacing="3.0">
            <Label text="客户端设置" styleClass="settings-title"/>
            <Label text="ARONA / PLANA CONFIG CHANNEL" styleClass="settings-caption"/>
        </VBox>
        <Region HBox.hgrow="ALWAYS"/>
        <Label text="✦" styleClass="settings-spark"/>
    </HBox>

    <VBox spacing="10.0">
        <HBox alignment="CENTER_LEFT" styleClass="config-row">
            <VBox spacing="2.0">
                <Label text="对话模型" styleClass="config-name"/>
                <Label text="当前用于诊断推理的模型" styleClass="config-description"/>
            </VBox>
            <Region HBox.hgrow="ALWAYS"/>
            <Label fx:id="modelValue" styleClass="config-value"/>
        </HBox>
        <HBox alignment="CENTER_LEFT" styleClass="config-row">
            <VBox spacing="2.0">
                <Label text="API 地址" styleClass="config-name"/>
                <Label text="模型服务连接端点" styleClass="config-description"/>
            </VBox>
            <Region HBox.hgrow="ALWAYS"/>
            <Label fx:id="baseUrlValue" styleClass="config-value"/>
        </HBox>
        <HBox alignment="CENTER_LEFT" styleClass="config-row">
            <VBox spacing="2.0">
                <Label text="最大尝试次数" styleClass="config-name"/>
                <Label text="瞬时故障时的有限重试" styleClass="config-description"/>
            </VBox>
            <Region HBox.hgrow="ALWAYS"/>
            <Label fx:id="retryValue" styleClass="config-value"/>
        </HBox>
        <HBox alignment="CENTER_LEFT" styleClass="config-row">
            <VBox spacing="2.0">
                <Label text="API Key" styleClass="config-name"/>
                <Label text="只显示加载状态，不显示密钥内容" styleClass="config-description"/>
            </VBox>
            <Region HBox.hgrow="ALWAYS"/>
            <Label fx:id="apiKeyValue" styleClass="config-value"/>
        </HBox>
    </VBox>

    <VBox spacing="5.0" styleClass="privacy-note">
        <Label text="安全边界" styleClass="privacy-title"/>
        <Label text="桌面客户端不会把 API Key 写入本地配置文件，也不会在界面中展示真实值。"
               wrapText="true" styleClass="privacy-text"/>
    </VBox>

    <Region VBox.vgrow="ALWAYS"/>
    <HBox alignment="CENTER_RIGHT">
        <Button text="完成" onAction="#closeWindow" styleClass="primary-button"/>
    </HBox>
</VBox>
